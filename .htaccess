<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── 301s: old .html URLs → clean slugs ──────────────────────────────────────
  RewriteRule ^blog/que-hacer-seguro-accidente-transito\.html$ /blog/que-hacer-seguro-accidente-transito [R=301,L]
  RewriteRule ^blog/fraude-en-seguros-estrategias-efectivas\.html$ /blog/fraude-en-seguros-estrategias-efectivas [R=301,L]
  RewriteRule ^blog/errores-comunes-al-elegir-seguro-auto\.html$ /blog/errores-comunes-al-elegir-seguro-auto [R=301,L]
  RewriteRule ^blog/servicio-de-asistencia-aseguradoras\.html$ /blog/servicio-de-asistencia-aseguradoras [R=301,L]
  RewriteRule ^blog/ranking-agosto25\.html$ /blog/ranking-ventas-autos-agosto-2025 [R=301,L]
  RewriteRule ^blog/freelance-a-pymes\.html$ /blog/freelance-a-pymes-proteccion-de-tu-negocio [R=301,L]

  # ── Landing coberturas ───────────────────────────────────────────────────────
  RewriteRule ^coberturas/auto/?$ coberturas/auto/index.html [L]
  RewriteRule ^coberturas/hogar/?$ coberturas/hogar/index.html [L]
  RewriteRule ^coberturas/moto/?$ coberturas/moto/index.html [L]

  # ── FAQ page ─────────────────────────────────────────────────────────────────
  RewriteRule ^faq/?$ faq/index.html [L]

  # ── Clean slug → .html file (generic — covers all current and future posts) ──
  RewriteRule ^blog/?$ blog/index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog/([^/]+)/?$ blog/$1.html [L]

</IfModule>